# Maintainer: Simon Späti <simon at ssp dot sh>

pkgname=omapic
pkgver=0.1.0
pkgrel=1
pkgdesc="Cut horizontal/vertical bands out of images"
arch=('x86_64')
url='https://github.com/sspaeti/omapic'
license=('MIT')
install='omapic.install'
depends=('qt6-base' 'qt6-declarative' 'wl-clipboard' 'xdg-desktop-portal')
optdepends=('xdg-desktop-portal-gtk: file open/save dialogs (or -kde / -gnome)')
makedepends=('qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omapic "$pkgdir/usr/bin/omapic"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/omapic.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omapic.svg"
  /usr/bin/install -Dm644 "$startdir/omapic.desktop" "$pkgdir/usr/share/applications/omapic.desktop"
}
